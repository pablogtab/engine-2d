{
  "name": "enginescript-vscode",
  "displayName": "EngineScript Language Support",
  "description": "Language support, syntax highlighting, and LSP tooling for EngineScript (.e2s)",
  "version": "1.1.0",
  "publisher": "Engine2D",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "activationEvents": [
    "onLanguage:enginescript",
    "onCommand:enginescript.restartServer",
    "onCommand:enginescript.compileProject"
  ],
  "contributes": {
    "languages": [
      {
        "id": "enginescript",
        "aliases": [
          "EngineScript",
          "enginescript",
          "e2s"
        ],
        "extensions": [
          ".e2s"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "enginescript",
        "scopeName": "source.enginescript",
        "path": "./syntaxes/enginescript.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "enginescript.restartServer",
        "title": "EngineScript: Restart Language Server"
      },
      {
        "command": "enginescript.compileProject",
        "title": "EngineScript: Compile Project"
      }
    ],
    "configuration": {
      "title": "EngineScript",
      "properties": {
        "enginescript.serverPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the EngineScript language server."
        },
        "enginescript.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the EngineScript compiler."
        },
        "enginescript.autoCompileOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Compile the owning Engine2D project after saving an .e2s script."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  }
}
