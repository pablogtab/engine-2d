{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "EngineScript",
  "scopeName": "source.enginescript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#decorators" },
    { "include": "#duration_literals" },
    { "include": "#numeric_literals" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.enginescript",
          "match": "//.*$"
        },
        {
          "name": "comment.block.enginescript",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.enginescript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.enginescript",
              "match": "\\\\([nrt\\\\\"'0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "entity.name.function.decorator.enginescript",
          "match": "@(behaviour|expose|inject|component|optional|service|system|event|asset|custom)\\b"
        },
        {
          "name": "entity.name.function.decorator.custom.enginescript",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "duration_literals": {
      "patterns": [
        {
          "name": "constant.numeric.duration.enginescript",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\.(ms|seconds|s|min|hours|h)\\b"
        }
      ]
    },
    "numeric_literals": {
      "patterns": [
        {
          "name": "constant.numeric.hex.enginescript",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.enginescript",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.float.enginescript",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.enginescript",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.enginescript",
          "match": "\\b(if|else|while|for|in|return|break|continue|await|async)\\b"
        },
        {
          "name": "keyword.declaration.enginescript",
          "match": "\\b(class|struct|interface|enum|function|constructor|let|const|var|import|export|from|as|extends|implements)\\b"
        },
        {
          "name": "storage.modifier.enginescript",
          "match": "\\b(public|private|protected|readonly|static|override)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.enginescript",
          "match": "\\b(Void|Bool|Int8|Int16|Int32|Int64|UInt8|UInt16|UInt32|UInt64|Int|UInt|Float|Float32|Float64|String|Vec2|Vec3|Vec4|Color|Duration|Entity|Entities|Array|FixedArray|Map|Set|Result|Task|Weak|Behaviour|Input|Log|RigidBody2D|Animator2D|Transform2D|SpriteRenderer2D|ParticleEmitter2D|Joint2D|Time|Physics|RaycastHit|Display|Audio|Scene|Assets|Asset|Texture|AudioClip|Font|DataAsset|Events|PlayerPrefs|UI|Tilemap|Particles|ParticleEffect2D|ParticleEmitOptions)\\b"
        },
        {
          "name": "entity.name.type.class.enginescript",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.enginescript",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.enginescript",
          "match": "\\b(null)\\b"
        },
        {
          "name": "variable.language.this.enginescript",
          "match": "\\b(this|super)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.enginescript",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.enginescript",
          "match": "(\\?\\.|\\?\\?|\\+|-|\\*|\\/|%|==|!=|<=|>=|<|>|&&|\\|\\||!|=|\\+=|-=|\\*=|\\/=|=>|\\?|:)"
        }
      ]
    }
  }
}
