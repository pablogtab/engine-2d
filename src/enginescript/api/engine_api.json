{
  "schemaVersion": 1,
  "abiVersion": 5,
  "sdkHash": "engine2d_abi_v5",
  "policy": {
    "scope": "gameplay-runtime-only",
    "parity": "editor-play-and-export",
    "newRuntimeCapability": "must-declare-script-binding-or-explicit-non-scriptable-status"
  },
  "types": [
    { "name": "Void" }, { "name": "Bool" }, { "name": "Int8" }, { "name": "Int16" },
    { "name": "Int32" }, { "name": "Int64" }, { "name": "UInt8" }, { "name": "UInt16" },
    { "name": "UInt32" }, { "name": "UInt64" }, { "name": "Int" }, { "name": "UInt" },
    { "name": "Float" }, { "name": "Float32" }, { "name": "Float64" }, { "name": "String" },
    { "name": "Vec2" }, { "name": "Vec3" }, { "name": "Vec4" }, { "name": "Color" },
    { "name": "Duration" }, { "name": "Entity" }, { "name": "Array" }, { "name": "FixedArray" },
    { "name": "Map" }, { "name": "Set" }, { "name": "Result" }, { "name": "Task" },
    { "name": "Weak" }, { "name": "Behaviour" }, { "name": "Input" }, { "name": "Log" },
    { "name": "RigidBody2D" }, { "name": "Animator2D" }, { "name": "Transform2D" },
    { "name": "SpriteRenderer2D" },
    { "name": "Time", "availability": "planned" }, { "name": "Physics", "availability": "planned" },
    { "name": "Scene" }, { "name": "Assets", "availability": "planned" },
    { "name": "Audio" }, { "name": "Events", "availability": "planned" },
    { "name": "UI", "availability": "planned" }, { "name": "Tilemap", "availability": "planned" },
    { "name": "ParticleEmitter2D", "availability": "planned" }, { "name": "Joint2D", "availability": "planned" }
  ],
  "functions": [
    { "name": "delay", "returnType": "Task<Void>" },
    { "name": "realDelay", "returnType": "Task<Void>" },
    { "name": "nextFrame", "returnType": "Task<Void>" },
    { "name": "fixedUpdate", "returnType": "Task<Void>" },
    { "name": "instantiate", "returnType": "Result<Entity>", "availability": "planned" },
    { "name": "findEntities", "returnType": "Array<Entity>", "availability": "planned" }
  ],
  "methods": [
    { "ownerType": "Audio", "name": "playSound", "returnType": "Bool", "minArguments": 1, "maxArguments": 3 },
    { "ownerType": "Audio", "name": "playMusic", "returnType": "Bool", "minArguments": 1, "maxArguments": 3 },
    { "ownerType": "Audio", "name": "stopMusic", "returnType": "Void" },
    { "ownerType": "Audio", "name": "pauseMusic", "returnType": "Void" },
    { "ownerType": "Audio", "name": "resumeMusic", "returnType": "Void" },
    { "ownerType": "Audio", "name": "setMasterVolume", "returnType": "Void", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Audio", "name": "setMusicVolume", "returnType": "Void", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Audio", "name": "setSfxVolume", "returnType": "Void", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Audio", "name": "masterVolume", "returnType": "Float" },
    { "ownerType": "Audio", "name": "musicVolume", "returnType": "Float" },
    { "ownerType": "Audio", "name": "sfxVolume", "returnType": "Float" },
    { "ownerType": "Scene", "name": "load", "returnType": "Bool", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Scene", "name": "currentName", "returnType": "String" }
  ]
}
