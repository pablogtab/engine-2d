    { "name": "realDelay", "returnType": "Task<Void>" },
    { "name": "nextFrame", "returnType": "Task<Void>" },
    { "name": "fixedUpdate", "returnType": "Task<Void>" },
    { "name": "instantiate", "returnType": "Result<Entity>", "availability": "planned" },
    { "name": "findEntities", "returnType": "Array<Entity>", "availability": "planned" }
  ],
  "methods": [
    { "ownerType": "Entities", "name": "create", "returnType": "Entity", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Entities", "name": "findByName", "returnType": "Entity", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Entities", "name": "findByTag", "returnType": "Entity", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Entities", "name": "exists", "returnType": "Bool", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Entities", "name": "findAllByTag", "returnType": "Array<Entity>", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Entities", "name": "findAllWithTransform", "returnType": "Array<Entity>" },
    { "ownerType": "Entities", "name": "hasTransform", "returnType": "Bool", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Entities", "name": "transform", "returnType": "Transform2D", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Entities", "name": "hasRigidBody", "returnType": "Bool", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Entities", "name": "rigidBody", "returnType": "RigidBody2D", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Entities", "name": "hasSpriteRenderer", "returnType": "Bool", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Entities", "name": "spriteRenderer", "returnType": "SpriteRenderer2D", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Audio", "name": "playSound", "returnType": "Bool", "minArguments": 1, "maxArguments": 3 },
    { "ownerType": "Audio", "name": "playMusic", "returnType": "Bool", "minArguments": 1, "maxArguments": 3 },
