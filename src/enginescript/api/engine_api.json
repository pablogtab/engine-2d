    { "name": "Int32" }, { "name": "Int64" }, { "name": "UInt8" }, { "name": "UInt16" },
    { "name": "UInt32" }, { "name": "UInt64" }, { "name": "Int" }, { "name": "UInt" },
    { "name": "Float" }, { "name": "Float32" }, { "name": "Float64" }, { "name": "String" },
    { "name": "Vec2" }, { "name": "Vec3" }, { "name": "Vec4" }, { "name": "Color" },
    { "name": "Duration" }, { "name": "Entity" }, { "name": "Entities" }, { "name": "Array" }, { "name": "FixedArray" },
    { "name": "Map" }, { "name": "Set" }, { "name": "Result" }, { "name": "Task" },
    { "name": "Weak" }, { "name": "Behaviour" }, { "name": "Input" }, { "name": "Log" },
    { "name": "RigidBody2D" }, { "name": "Animator2D" }, { "name": "Transform2D" },
    { "name": "SpriteRenderer2D" },
    { "name": "Time" }, { "name": "Physics", "availability": "planned" },
    { "name": "Scene" }, { "name": "Assets", "availability": "planned" },
    { "name": "Audio" }, { "name": "Events", "availability": "planned" },
    { "name": "UI", "availability": "planned" }, { "name": "Tilemap", "availability": "planned" },
    { "name": "ParticleEmitter2D", "availability": "planned" }, { "name": "Joint2D", "availability": "planned" }
  ],
  "functions": [
