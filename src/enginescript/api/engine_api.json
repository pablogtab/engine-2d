    { "ownerType": "Audio", "name": "pauseMusic", "returnType": "Void" },
    { "ownerType": "Audio", "name": "resumeMusic", "returnType": "Void" },
    { "ownerType": "Audio", "name": "setMasterVolume", "returnType": "Void", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Audio", "name": "setMusicVolume", "returnType": "Void", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Audio", "name": "setSfxVolume", "returnType": "Void", "minArguments": 1, "maxArguments": 1 },
    { "ownerType": "Audio", "name": "masterVolume", "returnType": "Float" },
    { "ownerType": "Audio", "name": "musicVolume", "returnType": "Float" },
    { "ownerType": "Audio", "name": "sfxVolume", "returnType": "Float" },
