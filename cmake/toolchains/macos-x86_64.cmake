set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_OSX_ARCHITECTURES x86_64 CACHE STRING "" FORCE)

get_filename_component(ENGINE_SOURCE_DIR_FROM_TOOLCHAIN "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(ENGINE_MACOS_X86_VCPKG_ROOT
    "${ENGINE_SOURCE_DIR_FROM_TOOLCHAIN}/build/toolchains/vcpkg"
    CACHE PATH "Local vcpkg checkout used for the Intel macOS build")
set(ENGINE_MACOS_X86_VCPKG_INSTALLED_DIR
    "${ENGINE_MACOS_X86_VCPKG_ROOT}/installed/x64-osx"
    CACHE PATH "Intel macOS dependency prefix produced by vcpkg")

if(NOT EXISTS "${ENGINE_MACOS_X86_VCPKG_INSTALLED_DIR}/share/sdl3/SDL3Config.cmake")
    message(FATAL_ERROR
        "Intel macOS SDL3 dependency is missing. Install it with:\n"
        "  VCPKG_ROOT=${ENGINE_MACOS_X86_VCPKG_ROOT} vcpkg install sdl3:x64-osx glm:x64-osx")
endif()

list(PREPEND CMAKE_PREFIX_PATH "${ENGINE_MACOS_X86_VCPKG_INSTALLED_DIR}")
list(PREPEND CMAKE_FIND_ROOT_PATH "${ENGINE_MACOS_X86_VCPKG_INSTALLED_DIR}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
