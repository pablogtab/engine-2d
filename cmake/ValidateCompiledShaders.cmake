if(NOT DEFINED ENGINE_SHADER_OUTPUT_DIR)
    message(FATAL_ERROR "ENGINE_SHADER_OUTPUT_DIR is required")
endif()

function(require_nonempty_file path)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Missing compiled shader variant: ${path}")
    endif()
    file(SIZE "${path}" size)
    if(size EQUAL 0)
        message(FATAL_ERROR "Compiled shader variant is empty: ${path}")
    endif()
endfunction()

if(ENGINE_HAS_RUNTIME_SHADER)
    set(spirv "${ENGINE_SHADER_OUTPUT_DIR}/night_vision.frag.spv")
    require_nonempty_file("${spirv}")
    file(READ "${spirv}" spirv_magic OFFSET 0 LIMIT 4 HEX)
    if(NOT spirv_magic STREQUAL "03022307")
        message(FATAL_ERROR "Night Vision SPIR-V variant has an invalid magic value")
    endif()

    set(dxil "${ENGINE_SHADER_OUTPUT_DIR}/night_vision.frag.dxil")
    require_nonempty_file("${dxil}")
    file(READ "${dxil}" dxil_magic OFFSET 0 LIMIT 4 HEX)
    if(NOT dxil_magic STREQUAL "44584243")
        message(FATAL_ERROR "Night Vision DXIL variant is not a DXBC container")
    endif()

    set(msl "${ENGINE_SHADER_OUTPUT_DIR}/night_vision.frag.msl")
    require_nonempty_file("${msl}")
    file(READ "${msl}" msl_prefix OFFSET 0 LIMIT 256)
    string(FIND "${msl_prefix}" "metal_stdlib" msl_header_offset)
    if(msl_header_offset EQUAL -1)
        message(FATAL_ERROR "Night Vision MSL variant does not contain the Metal standard library header")
    endif()
endif()

set(builtin_spirv "${ENGINE_SHADER_OUTPUT_DIR}/builtin/lit_sprite.frag.spv")
require_nonempty_file("${builtin_spirv}")
file(READ "${builtin_spirv}" builtin_spirv_magic OFFSET 0 LIMIT 4 HEX)
if(NOT builtin_spirv_magic STREQUAL "03022307")
    message(FATAL_ERROR "Lit Sprite SPIR-V variant has an invalid magic value")
endif()

set(builtin_dxil "${ENGINE_SHADER_OUTPUT_DIR}/builtin/lit_sprite.frag.dxil")
require_nonempty_file("${builtin_dxil}")
file(READ "${builtin_dxil}" builtin_dxil_magic OFFSET 0 LIMIT 4 HEX)
if(NOT builtin_dxil_magic STREQUAL "44584243")
    message(FATAL_ERROR "Lit Sprite DXIL variant is not a DXBC container")
endif()

set(builtin_msl "${ENGINE_SHADER_OUTPUT_DIR}/builtin/lit_sprite.frag.msl")
require_nonempty_file("${builtin_msl}")
file(READ "${builtin_msl}" builtin_msl_prefix OFFSET 0 LIMIT 256)
string(FIND "${builtin_msl_prefix}" "metal_stdlib" builtin_msl_header_offset)
if(builtin_msl_header_offset EQUAL -1)
    message(FATAL_ERROR "Lit Sprite MSL variant does not contain the Metal standard library header")
endif()

message(STATUS "Compiled shader variants are structurally valid")
